# انسخ إلى backend/.env.local أو صدّر المتغيرات قبل uvicorn
# مثال SQLite (المسار المطلق يعمل بشكل أموثق على macOS/Linux):
# DATABASE_URL=sqlite+aiosqlite:////ABSOLUTE_PATH_TO_REPO/backend/data/dev.sqlite
# DEBUG=true
#
# بذرة admin (قاعدة فارغة فقط) — نفس القيم الافتراضية في scripts/run_dev_local.sh
# DEV_SEED_ADMIN_USERNAME=dev
# DEV_SEED_ADMIN_PASSWORD=devlocal123
# DEV_SEED_ADMIN_EMAIL=dev@localhost
